+
+/// WASI: run a bundled subcommand (`mke2fs`, `mkfs.erofs`) in this process, with the command's environment.
+#[cfg(target_os = "wasi")]
+pub fn run_in_process(command: &std::process::Command) -> Result<i32> {
+    for (k, v) in command.get_envs() {
+        match v {
+            Some(v) => unsafe { std::env::set_var(k, v) },
+            None => unsafe { std::env::remove_var(k) },
+        }
+    }
+    let mut args = command.get_args();
+    let sub = args.next().ok_or_else(|| anyhow!("No subcommand"))?.to_owned();
+    let mut argv = Argv::default();
+    argv.push(sub.clone())?;
+    for a in args {
+        argv.push(a.to_owned())?;
+    }
+    // getopt keeps its position between calls; a separate process always started fresh.
+    unsafe extern "C" {
+        static mut optind: std::ffi::c_int;
+    }
+    unsafe { optind = 0 };
+    let ret = match sub.to_str() {
+        Some("mke2fs") => unsafe { crate::bindings::e2fs::mke2fs_main(argv.argc(), argv.argv()) },
+        Some("mkfs.erofs") => unsafe { crate::bindings::erofs::mkfs_erofs_main(argv.argc(), argv.argv()) },
+        _ => return Err(anyhow!("Unknown subcommand: {sub:?}")),
+    };
+    Ok(ret)
+}
